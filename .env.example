# =============================================================================
# Copy this file to `.env` and fill in your values.
# Everything is optional — without it the site runs in local/demo mode.
# =============================================================================

# --- Supabase (free tier) -----------------------------------------------------
# Dashboard → Project Settings → Data API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Reviewer accounts --------------------------------------------------------
# Reviewers sign up with a username. Supabase needs an email, so one is
# synthesised as <username>@<this domain>. It is never shown to anyone.
VITE_AUTH_EMAIL_DOMAIN=users.sicraft11.app

# --- Local-only owner PIN -----------------------------------------------------
# ONLY used when Supabase is not configured (offline previewing).
# Once Supabase is connected, edit mode uses your real owner account instead.
VITE_ADMIN_PIN=sicraft-owner
